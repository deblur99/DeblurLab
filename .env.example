# /api/hit 이 Supabase에 유입 이벤트를 쓸 때 사용한다.
# Vercel 프로젝트 환경변수에 등록해야 하며, 두 값 중 하나라도 없으면
# 집계는 조용히 건너뛰고 사이트는 정상 동작한다.

# Supabase 프로젝트: deblurlab-web (ap-northeast-2 / 서울)
SUPABASE_URL=https://urnwwricfdrgawubyrtp.supabase.co

# ★ secret(service_role) 키. 절대 클라이언트에 노출하지 말 것.
# Supabase 대시보드 → Project Settings → API Keys 에서 복사한다.
SUPABASE_SERVICE_ROLE_KEY=
