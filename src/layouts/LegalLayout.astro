---
import BaseLayout from './BaseLayout.astro';
import { parsePath } from '../consts';
import { useTranslations } from '../i18n/ui';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    updated: string;
    effective?: string;
  };
}

const { frontmatter } = Astro.props;
const { locale } = parsePath(Astro.url.pathname);
const t = useTranslations(locale);

const dateFormat = new Intl.DateTimeFormat(locale === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const meta = [
  `${t('legal.updated')}: ${dateFormat.format(new Date(frontmatter.updated))}`,
  ...(frontmatter.effective
    ? [`${t('legal.effective')}: ${dateFormat.format(new Date(frontmatter.effective))}`]
    : []),
].join(' · ');
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="shell page-head">
    <h1>{frontmatter.title}</h1>
    <p class="page-head__meta">{meta}</p>
  </div>
  <div class="shell page-body">
    <div class="prose">
      <slot />
    </div>
  </div>
</BaseLayout>
