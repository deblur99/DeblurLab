---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LOCALES, SITE_URL, localePath, parsePath } from '../consts';
import { useTranslations } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { locale, path } = parsePath(Astro.url.pathname);
const t = useTranslations(locale);

const canonical = new URL(localePath(locale, path), SITE_URL).href;
const pageTitle = path === '/' ? `DeblurLab — ${t('site.tagline')}` : `${title} — DeblurLab`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), SITE_URL).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('ko', path), SITE_URL).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DeblurLab" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/deblurlab-logo.png', SITE_URL).href} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/deblurlab-logo.png" />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <SiteHeader locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
